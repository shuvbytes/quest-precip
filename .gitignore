*.pyc
.pytest_cache/
.DS_Store
.ipynb_checkpoints/

# Claude Code local files (settings, plans, memory): never published
.claude/

# Local check plots (regenerate with pipeline/m2_check.py etc.)
outputs/

# Downloaded source geodata for web/geo (re-fetch with pipeline/make_geo.py)
data/geo_src/
